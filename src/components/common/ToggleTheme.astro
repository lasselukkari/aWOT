---
import { Icon } from 'astro-icon/components';

import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  /** Icon shown in light mode (it invites to switch to dark). */
  iconName?: string;
  /** Icon shown in dark mode. */
  iconNameDark?: string;
}

const {
  label = 'Dark mode',
  class:
    className = 'text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-6 h-6',
  iconName = 'tabler:moon',
  iconNameDark = 'tabler:sun',
} = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <aw-theme-toggle>
      <button type="button" class:list={[className, 'invisible']} aria-label={label} aria-pressed="false" data-aw-toggle-color-scheme>
        <span class:list={['relative block', iconClass]}>
          <Icon
            name={iconName}
            class="absolute inset-0 h-full w-full transition-[opacity,transform] duration-200 motion-reduce:transition-none [html.dark_&]:-rotate-90 [html.dark_&]:scale-0 [html.dark_&]:opacity-0"
          />
          <Icon
            name={iconNameDark}
            class="absolute inset-0 h-full w-full rotate-90 scale-0 opacity-0 transition-[opacity,transform] duration-200 motion-reduce:transition-none [html.dark_&]:rotate-0 [html.dark_&]:scale-100 [html.dark_&]:opacity-100"
          />
        </span>
      </button>
    </aw-theme-toggle>
  )
}

<style>
  aw-theme-toggle {
    display: contents;
  }
</style>

<!-- Initialize during parsing so the icon does not wait for deferred page scripts. -->
<script is:inline>
(() => {
  class AwThemeToggle extends HTMLElement {
    events;

    connectedCallback() {
      this.initialize();
    }

    initialize() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const button = this.querySelector('[data-aw-toggle-color-scheme]');
      if (!button) return;

      const updateState = () => {
        button.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
      };
      updateState();
      // Keep the control hidden without JavaScript, while reserving its space.
      button.classList.remove('invisible');

      button.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        const theme = isDark ? 'dark' : 'light';
        document.documentElement.style.colorScheme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {
          // The theme still works when browser privacy settings block storage.
        }
        updateState();
        document.dispatchEvent(new CustomEvent('aw:theme-change', { detail: { theme } }));
      }, { signal });
      document.addEventListener('aw:theme-change', updateState, { signal });
    }

    disconnectedCallback() {
      this.events?.abort();
    }
  }

  if (!customElements.get('aw-theme-toggle')) {
    customElements.define('aw-theme-toggle', AwThemeToggle);
  } else {
    // Later instances can connect before their button has been parsed.
    const toggle = document.currentScript.previousElementSibling;
    if (toggle?.matches('aw-theme-toggle')) toggle.initialize();
  }
})();
</script>
