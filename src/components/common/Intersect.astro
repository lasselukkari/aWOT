---
// Reveal-on-scroll animation controller. A single instance is rendered by the
// layout; it observes elements using the `intersect` Tailwind variants and
// staggers their reveal. The custom-element lifecycle re-runs it on each
// client-side navigation, so no manual `astro:after-swap` wiring is needed.
//
// Rules that keep the reveal snappy:
// - The stagger is computed per observer batch (the elements that enter
//   together) and capped, so a fast scroll or an anchor jump never queues
//   seconds of delay.
// - An element counts as visible only when it actually intersects, so
//   off-screen elements are never animated ahead of time.
// - Only one level fades: a section whose children animate on their own is
//   revealed at once, so items are not dimmed by a fading parent.
---

<aw-intersect aria-hidden="true"></aw-intersect>

<style>
  aw-intersect {
    display: none;
  }
</style>

<script>
  /* Inspired by: https://github.com/heidkaemper/tailwindcss-intersect */
  const SELECTOR = [
    '[class*=" intersect:"]',
    '[class*=":intersect:"]',
    '[class^="intersect:"]',
    '[class="intersect"]',
    '[class*=" intersect "]',
    '[class^="intersect "]',
    '[class$=" intersect"]',
  ].join(',');

  const STAGGER_MS = 60;
  const STAGGER_MAX_STEPS = 4;

  class AwIntersect extends HTMLElement {
    private observer: IntersectionObserver | null = null;
    private elements: HTMLElement[] = [];
    private thresholds = new WeakMap<Element, number>();
    private onThemeChange = () => this.removeAnimationDelay();

    connectedCallback() {
      // The custom-element lifecycle re-runs this on every client-side
      // navigation, so each page (initial load and navigations alike) reveals
      // its sections with the same fade-in as you scroll them into view.
      this.start();
      document.addEventListener('aw:theme-change', this.onThemeChange);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      document.removeEventListener('aw:theme-change', this.onThemeChange);
    }

    private getThreshold(el: HTMLElement): number {
      if (el.classList.contains('intersect-full')) return 0.99;
      if (el.classList.contains('intersect-half')) return 0.5;
      if (el.classList.contains('intersect-quarter')) return 0.25;
      return 0;
    }

    private start() {
      this.observer?.disconnect();
      this.elements = Array.from(document.querySelectorAll<HTMLElement>(SELECTOR));

      const observed: HTMLElement[] = [];
      this.elements.forEach((el) => {
        if (el.querySelector(SELECTOR)) {
          // Container with animated children: show it at once, its children
          // carry the animation.
          el.style.animationDuration = '0s';
          el.setAttribute('data-animated', 'true');
          return;
        }
        el.setAttribute('no-intersect', '');
        this.thresholds.set(el, this.getThreshold(el));
        observed.push(el);
      });

      const callback: IntersectionObserverCallback = (entries) => {
        let index = 0;
        for (const entry of entries) {
          const target = entry.target as HTMLElement;
          const threshold = this.thresholds.get(target) ?? 0;
          const once = target.classList.contains('intersect-once');
          const visible = entry.isIntersecting && entry.intersectionRatio >= threshold;

          if (visible) {
            if (target.hasAttribute('data-animated')) continue;
            const delay = target.classList.contains('intersect-no-queue')
              ? 0
              : Math.min(index++, STAGGER_MAX_STEPS) * STAGGER_MS;
            target.removeAttribute('no-intersect');
            target.setAttribute('data-animated', 'true');
            target.style.animationDuration = '';
            target.style.animationDelay = `${delay}ms`;
            target.style.transitionDelay = `${delay}ms`;
            if (once) this.observer?.unobserve(target);
          } else if (!once) {
            target.setAttribute('no-intersect', '');
            target.removeAttribute('data-animated');
            target.style.animationDelay = '';
            target.style.transitionDelay = '';
          }
        }
      };

      this.observer = new IntersectionObserver(callback, { threshold: [0, 0.25, 0.5, 0.99] });
      observed.forEach((el) => this.observer?.observe(el));
    }

    /*
      REF: #643;
      Remove the stagger delay so toggling the theme doesn't flicker. The
      Observer only clears delays once elements leave the viewport, so the
      <aw-theme-toggle> element asks us to clear them on demand.
    */
    private removeAnimationDelay() {
      this.elements.forEach((el) => {
        if (el.getAttribute('data-animated') === 'true') {
          el.style.transitionDelay = '';
          el.style.animationDelay = '';
        }
      });
    }
  }

  if (!customElements.get('aw-intersect')) {
    customElements.define('aw-intersect', AwIntersect);
  }
</script>
